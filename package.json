{
  "name": "jira-cli",
  "version": "1.0.0",
  "description": "A command line tool for Jira",
  "main": "dist/index.js",
  "bin": {
    "jira": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node ./dist/index.js",
    "dev": "ts-node src/index.ts",
    "watch": "tsc -w",
    "prepare": "npm run build",
    "link": "npm link",
    "pkg": "tsc && pkg . --target node18-linux-x64 --output jira-cli"
  },
  "keywords": [
    "jira",
    "cli",
    "task",
    "management"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "chalk": "^4.1.2",
    "commander": "^9.0.0",
    "configstore": "^5.0.1",
    "inquirer": "^8.2.0",
    "keypress": "^0.2.1",
    "open": "^8.4.0",
    "ora": "^5.4.1",
    "table": "^6.8.0"
  },
  "devDependencies": {
    "@types/chalk": "^0.4.31",
    "@types/configstore": "^6.0.2",
    "@types/inquirer": "^9.0.7",
    "@types/inquirer-autocomplete-prompt": "^3.0.3",
    "@types/keypress": "^2.0.30",
    "@types/node": "^22.15.2",
    "@types/table": "^6.0.0",
    "typescript": "^5.8.3"
  },
  "pkg": {
    "scripts": "dist/**/*.js"
  }
}
